{%- block editor_widget -%}
    {% set content = value|editor(false)|filter_allowed_components(allowed_components) %}
    {% set attr = attr|merge(attr, {value: content|editor_serialized}) %}
    <div class="ux-editor">
        {# ponytail: tokens BO (pas dark: media) — le package Tailwind réagit au OS, la modale admin reste claire #}
        <div {{ stimulus_controller('editor') }} class="rounded-lg border border-border bg-muted/30 p-4">
            <input type="hidden" {{ block('widget_attributes') }} {{ stimulus_target('editor', 'input') }}>

            <div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                    <p class="text-sm font-medium text-foreground">{{ 'editor.title'|trans({}, 'forms') }}</p>
                    <p class="mt-1 text-sm text-muted-foreground">{{ 'editor.hint'|trans({}, 'forms') }}</p>
                </div>
                <twig:Button type="button" variant="outline" class="shrink-0" data-action="click->editor#open">
                    <twig:ux:icon name="lucide:pencil" />
                    {{ 'editor.open'|trans({}, 'forms') }}
                </twig:Button>
            </div>
            <dialog {{ stimulus_target('editor', 'modal') }} class="ux-editor-dialog mt-4 m-0 h-full max-h-full w-full max-w-full border-0 bg-transparent p-0 text-inherit shadow-none backdrop:bg-black/65 backdrop:backdrop-blur-[2px] [&::backdrop]:bg-black/65 z-[100] ux-editor--modal">
                <twig:UX:Editor :value="content" data-editor-target="editor" :allowedComponents="allowed_components" :inputId="id" :previewEnabled="preview_enabled"/>
            </dialog>
        </div>
    </div>
{%- endblock editor_widget -%}
