{% form_theme form '@UXEditor/form_theme.html.twig' %}

<div{{ attributes.defaults({class: 'c-component-edit group relative rounded-2xl border border-slate-700/70 bg-slate-900/50 shadow-lg ring-1 ring-white/5 transition hover:border-slate-600 hover:ring-white/10', 'data-key-of-component': keyOfComponent, ...stimulus_controller('editor-edit')}) }}>
    <div class="flex flex-col gap-3 border-b border-slate-800/80 px-4 pb-3 pt-4 sm:flex-row sm:items-start sm:justify-between">
        <div class="flex min-w-0 flex-1 items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 cursor-grab items-center justify-center rounded-lg border border-slate-700/80 bg-slate-800/60 text-slate-400 active:cursor-grabbing" sortable-handle aria-hidden="true">
                <twig:ux:icon name="mdi:drag" class="h-5 w-5" />
            </span>
            <div class="min-w-0">
                <h2 class="truncate text-lg font-sans text-white">{{ component }}</h2>
                <p class="mt-0.5 text-xs text-slate-500">Faites glisser la poignée pour réordonner ce bloc.</p>
            </div>
        </div>
        <div class="flex shrink-0 items-center gap-2 self-start sm:self-center">
            <button type="button" class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-rose-900/60 text-rose-400 transition hover:border-rose-500 hover:bg-rose-950/40 hover:text-rose-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500/70" title="Supprimer ce bloc" data-action="live#emitUp" data-live-event-param="editor:remove" data-live-keys-param="{{ keyOfComponent }}" aria-label="Supprimer le bloc">
                <twig:ux:icon name="tabler:trash" class="h-4 w-4" />
            </button>
        </div>
    </div>

    {% if fields|length > 1 %}
    <div class="flex flex-wrap gap-2 border-b border-slate-800/60 px-4 py-3" role="tablist" aria-label="Sections du formulaire">
        {% for f in fields %}
            {% set name = f.metadata.name %}
            <button type="button" role="tab" aria-selected="{{ currentFieldsFilter is same as(name) ? 'true' : 'false' }}" class="c-btn inline-flex items-center gap-2 rounded-full border px-3 py-1.5 text-xs font-medium transition focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/80 {{ currentFieldsFilter is same as(name) ? 'active border-sky-500/70 bg-sky-950/50 text-sky-100' : 'border-slate-700 bg-slate-800/40 text-slate-300 hover:border-slate-500 hover:text-white' }}" {{ live_action('filter', {name : name}) }}>
                <twig:ux:icon :name="f.metadata.icon" class="h-3.5 w-3.5 opacity-90" />
                {{ name }}
            </button>
        {% endfor %}
    </div>
    {% endif %}

    <div class="px-4 py-5">
        {{ form_widget(form) }}

        {% if metadata is not null and metadata.isContainer %}
            <div {{ stimulus_target('editor', 'droppableContainer sortableContainer') }} class="c-component-edit__children mt-6 rounded-2xl border-1 border-dashed border-sky-500/40 bg-slate-950/30 p-1 transition hover:border-sky-400/60" id="{{ keyOfComponent }}_children">
                {% for k, child in c.children %}
                    <twig:UX:Editor:ComponentEdit :c="child" sortable :key="component.id" :editorId="editorId" keyOfComponent="{{ keyOfComponent }}.{{ k }}"/>
                {% endfor %}

                <button type="button" class="flex w-full flex-col items-center justify-center gap-2 rounded-xl border border-transparent px-4 py-6 text-sm font-medium text-sky-300/90 transition hover:border-sky-500/30 hover:bg-sky-950/20 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-500/70" {{ stimulus_action('editor', 'setSortable') }}>
                    <twig:ux:icon name="material-symbols:view-object-track" class="h-7 w-7 text-sky-400" />
                    Ajouter un composant dans ce conteneur
                </button>
            </div>
        {% endif %}
    </div>
</div>
