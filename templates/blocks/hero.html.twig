<section class="{{ layout == 'split' ? 'grid items-center gap-8 md:grid-cols-2' : '' }}">
    <div>
        <h2 class="text-4xl font-semibold tracking-tight text-zinc-900">{{ title }}</h2>
        {% if subtitle %}
            <p class="mt-3 text-lg text-zinc-600">{{ subtitle }}</p>
        {% endif %}
        {% if button.label|default('') %}
            {% include '@PageBuilder/blocks/button.html.twig' with {
                label: button.label,
                url: button.url,
                style: button.style,
                class: 'mt-6',
            } only %}
        {% endif %}
    </div>
    {% if layout == 'split' %}
        {% if image %}
            {{ builder_media(image, '', 'w-full rounded-xl') }}
        {% else %}
            <div class="flex h-48 items-center justify-center rounded-xl bg-zinc-100 text-sm text-zinc-400">Image</div>
        {% endif %}
    {% endif %}
</section>
